# Analytics (optional). Leave empty and nothing is loaded and no cookie notice is shown.
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA4_ID=
# Meta (Facebook) Pixel ID, e.g. 123456789012345
VITE_META_PIXEL_ID=

# Enquiry form email (set these in Vercel, not in this file). See README → "Enquiry emails".
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender on a domain verified in Resend
ENQUIRY_FROM=Serene Heights Website <website@sereneheightsnathiagali.com>
# Where enquiries are delivered (comma separated for several)
ENQUIRY_TO=info@sereneheightsnathiagali.com
